# Database (Vercel Postgres / Neon in production, local Postgres in dev).
# DIRECT_URL only matters against pooled providers (Neon/PgBouncer) - point
# it at the same database as DATABASE_URL but without the connection
# pooler, since `prisma migrate` needs a direct connection to run DDL. For
# plain local Postgres these can be identical.
DATABASE_URL="postgresql://antlerboard:antlerboard_dev@localhost:5432/antlerboard"
DIRECT_URL="postgresql://antlerboard:antlerboard_dev@localhost:5432/antlerboard"

# Yahoo OAuth (Yahoo Developer app: https://developer.yahoo.com/apps/).
# Never exposed to the browser - server-side only (see src/lib/yahoo/client.ts).
# The app boots and runs fully without these set - isYahooConfigured() gates
# every Yahoo-dependent code path, so leave them unset until Yahoo approves
# the API application. Once approved:
#   1. Register the callback URL below as the app's redirect URI in the
#      Yahoo Developer console.
#   2. Set these three from the resulting app's Client ID/Secret.
#   3. Everything else (league selection, sync) is configured at runtime via
#      Commissioner > Yahoo, not through env vars - there is no
#      YAHOO_LEAGUE_ID env var; the selected league/game key is stored on
#      YahooConnection in the database once a commissioner picks it there.
YAHOO_CLIENT_ID=""
YAHOO_CLIENT_SECRET=""
YAHOO_REDIRECT_URI="http://localhost:3000/api/yahoo/callback"

# Secret used to sign session cookies for commissioner/manager auth.
AUTH_SECRET="change-me-to-a-long-random-string"

# Vercel Cron secret - scheduled routes verify this header to reject public calls.
CRON_SECRET="change-me-to-a-long-random-string"

# Web Push (VAPID) - optional, only needed if push notifications are enabled.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:commissioner@example.com"
